# Professional Security Audit Platform - Environment Configuration

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
API_PORT=5000

# Security Settings
SECRET_KEY=change-this-key-in-production
REQUIRE_AUTHORIZATION=True

# Scanning Configuration
MAX_SCAN_TIMEOUT=300
ENABLE_PORT_SCAN=True
ENABLE_SUBDOMAIN_SCAN=True
ENABLE_VULNERABILITY_SCAN=True
ENABLE_EXPLOIT_ANALYSIS=True

# Logging
LOG_LEVEL=INFO
LOG_ALL_ACTIVITIES=True

# Defender Information
DEFENDER_NAME=Kaihaan Afghan
DEFENDER_STATUS=RED LINE ACTIVE
DEFENDER_LOCATION=Afghanistan
